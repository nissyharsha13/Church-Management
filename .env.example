# Admin login — generate real values with: npm run auth:hash -- '<password>'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt.16384.8.1.<salt>.<hash>
AUTH_SECRET=<at least 32 random characters>

# Live streaming (optional) — see docs/STREAMING-SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AI_GATEWAY_MODEL=anthropic/claude-haiku-5.5   # override the Telugu transliteration model
